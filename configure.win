#!/bin/sh
# configure.win for the mrwin package (Windows, run under Rtools' sh).
#
# Optional Rust backend, mirroring ./configure. Generates src/Makevars.win.

set -e

CARGO_BIN=""
if [ -n "${CARGO}" ] && [ -x "${CARGO}" ]; then
  CARGO_BIN="${CARGO}"
elif command -v cargo >/dev/null 2>&1; then
  CARGO_BIN="$(command -v cargo)"
elif [ -x "${HOME}/.cargo/bin/cargo" ]; then
  CARGO_BIN="${HOME}/.cargo/bin/cargo"
elif [ -x "${USERPROFILE}/.cargo/bin/cargo.exe" ]; then
  CARGO_BIN="${USERPROFILE}/.cargo/bin/cargo.exe"
fi

if [ -n "${CARGO_BIN}" ]; then
  echo "configure.win: found cargo at ${CARGO_BIN}; enabling the Rust backend."
  cat > src/Makevars.win <<'MK'
# Auto-generated by ./configure.win (Rust backend ENABLED). Do not edit by hand.
TARGET = x86_64-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libmrwinrust.a

PKG_CPPFLAGS = -DMRWIN_HAVE_RUST
# Static Rust runtime needs these Windows system libraries.
PKG_LIBS = -L$(LIBDIR) -lmrwinrust \
	-lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll -lkernel32

$(SHLIB): $(STATLIB)

$(STATLIB):
	cargo build --lib --release --target=$(TARGET) \
		--manifest-path=./rust/mrwinrust/Cargo.toml \
		--target-dir $(TARGET_DIR)

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(TARGET_DIR)

.PHONY: clean
MK
else
  echo "configure.win: cargo not found; installing WITHOUT the Rust backend (dense/sparse only)."
  cat > src/Makevars.win <<'MK'
# Auto-generated by ./configure.win (Rust backend DISABLED: cargo not found).
PKG_CPPFLAGS =
PKG_LIBS =

clean:
	rm -Rf $(SHLIB) $(OBJECTS)

.PHONY: clean
MK
fi

exit 0
