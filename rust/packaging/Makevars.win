# Windows template Makevars for the extendr `mrwinrust` static library.
# Copy into `src/Makevars.win` when wiring the Rust backend on Windows.

TARGET = $(subst 64,x86_64,$(subst 32,i686,$(WIN)))-pc-windows-gnu
TARGET_DIR = ./rust/target
LIBDIR = $(TARGET_DIR)/$(TARGET)/release
STATLIB = $(LIBDIR)/libmrwinrust.a
PKG_LIBS = -L$(LIBDIR) -lmrwinrust -lws2_32 -ladvapi32 -luserenv -lbcrypt -lntdll

CARGO_BUILD = cargo build --release --target=$(TARGET) \
	--manifest-path=./rust/mrwinrust/Cargo.toml \
	--target-dir $(TARGET_DIR)

$(SHLIB): $(STATLIB)

$(STATLIB):
	$(CARGO_BUILD)

clean:
	rm -Rf $(SHLIB) $(OBJECTS) $(STATLIB) $(TARGET_DIR)

.PHONY: clean
