#!/bin/sh
# configure for the mrwin package (Unix/macOS).
#
# The Rust backend is OPTIONAL. If a Rust toolchain (cargo) is found, the
# compiled win/loss kernel is built and linked, enabling backend = "rust".
# If cargo is absent, the package still installs with the dense/sparse R
# backends and backend = "rust" raises an actionable error at run time.
#
# This script generates src/Makevars. Do not edit src/Makevars by hand.

set -e

# Locate cargo: respect $CARGO, then PATH, then the default rustup location.
CARGO_BIN=""
if [ -n "${CARGO}" ] && [ -x "${CARGO}" ]; then
  CARGO_BIN="${CARGO}"
elif command -v cargo >/dev/null 2>&1; then
  CARGO_BIN="$(command -v cargo)"
elif [ -x "${HOME}/.cargo/bin/cargo" ]; then
  CARGO_BIN="${HOME}/.cargo/bin/cargo"
fi

if [ -n "${CARGO_BIN}" ]; then
  echo "configure: found cargo at ${CARGO_BIN}; enabling the Rust backend."
  CARGO_DIR="$(dirname "${CARGO_BIN}")"
  cat > src/Makevars <<MK
# Auto-generated by ./configure (Rust backend ENABLED). Do not edit by hand.
TARGET_DIR = ./rust/target
LIBDIR = \$(TARGET_DIR)/release
STATLIB = \$(LIBDIR)/libmrwinrust.a

PKG_CPPFLAGS = -DMRWIN_HAVE_RUST
PKG_LIBS = -L\$(LIBDIR) -lmrwinrust

\$(SHLIB): \$(STATLIB)

\$(STATLIB):
	export PATH="\$(PATH):${CARGO_DIR}" && \\
	cargo build --lib --release \\
		--manifest-path=./rust/mrwinrust/Cargo.toml \\
		--target-dir \$(TARGET_DIR)

clean:
	rm -Rf \$(SHLIB) \$(OBJECTS) \$(TARGET_DIR)

.PHONY: clean
MK
else
  echo "configure: cargo not found; installing WITHOUT the Rust backend (dense/sparse only)."
  echo "configure: to enable backend = 'rust', install Rust (https://rustup.rs) and reinstall."
  cat > src/Makevars <<'MK'
# Auto-generated by ./configure (Rust backend DISABLED: cargo not found).
# entrypoint.c compiles without MRWIN_HAVE_RUST, so no Rust symbols are linked.
PKG_CPPFLAGS =
PKG_LIBS =

clean:
	rm -Rf $(SHLIB) $(OBJECTS)

.PHONY: clean
MK
fi

exit 0
